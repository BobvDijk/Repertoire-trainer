rules_version = '2';
// Each signed-in user can only read and write their own sync documents.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/data/{key} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && key in ['pgn-w', 'pgn-b', 'state', 'progress']
        && request.resource.data.keys().hasOnly(['t', 'by', 'json'])
        && request.resource.data.t is int
        && request.resource.data.json is string
        && request.resource.data.json.size() < 1000000;
    }
  }
}
